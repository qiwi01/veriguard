# 🤖 VeriGuard - Environment Configuration

# Telegram Bot Token (from @BotFather)
# 1. Open Telegram
# 2. Search for @BotFather
# 3. Send /newbot and follow the instructions
# 4. Copy the token you receive (looks like: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11)
BOT_TOKEN=your_bot_token_here

# Webhook secret for securing incoming updates (choose any random string)
WEBHOOK_SECRET=supersecret12345

# Port for webhook server (Railway/Render/Koyeb may override this automatically)
PORT=8080

# 🔑 HOW TO GET YOUR TELEGRAM USER ID (ADMIN_USER_ID):
# 
# Option 1 — Use @userinfobot (easiest):
#   1. Open Telegram → search for @userinfobot
#   2. Start a chat and send ANY message
#   3. It will reply with your numeric User ID (e.g., 123456789)
#
# Option 2 — Use @getmyid_bot:
#   1. Open Telegram → search for @getmyid_bot
#   2. Send /start
#   3. It will show your ID
#
# Option 3 — Use @JsonDumpBot:
#   1. Open Telegram → search for @JsonDumpBot
#   2. Forward any message to it
#   3. It will show a JSON with your "from":{"id": YOUR_ID_HERE}
#
# Paste the number below (digits only, no quotes):
ADMIN_USER_ID=your_telegram_user_id_here

# Optional: Public domain for webhook (auto-set on Railway)
# If deploying on Railway, leave blank — it auto-detects.
# If deploying elsewhere, set to your domain: https://your-bot.xyz
RAILWAY_PUBLIC_DOMAIN=
